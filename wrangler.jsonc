{
  "name": "miniguide-ai",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": ".cloudflare/output/v1/workers/default/assets",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  },
  "env": {
    "ASSETS": { "type": "assets" }
  },
  "vars": {
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuYWkuc2FqYWxsYWJzLmNvbSQ"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }
}