{
  "name": "miniguide-ai",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": ".cloudflare/output/v1/workers/default/assets",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  },
  "env": {
    "ASSETS": { "type": "assets" }
  }
}