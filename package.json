    "@hookform/resolvers": "^5.2.2",
    "@opennextjs/cloudflare": "^1.20.18",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "^7.9.1",
    "@prisma/extension-accelerate": "^3.0.1",
    "@uiw/react-md-editor": "^4.0.8",
    "ai": "^7.0.148",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.548.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "prisma": "^7.9.1",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.65.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "svix": "^1.84.1",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.3",
    "zod": "^4.1.12",
    "zustand": "^5.0.9"
