    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.14",
    "@vitest/ui": "4.0.14",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^27.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.0.14",
    "wrangler": "^4.166.0"
  },
  "type": "module"
